{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZEX TV",
  "version": "0.1.0",
  "identifier": "com.zex.tv",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ZEX TV",
        "label": "main",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": true,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#080810"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://covers.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost http://covers.localhost https://api.tmdb.org https://*.tmdb.org https://*.themoviedb.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
